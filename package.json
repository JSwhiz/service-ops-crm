{
  "name": "service-ops-crm",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "echo \"Root dev orchestration will be connected after app runtime stabilization\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "pnpm -r format",
    "clean": "pnpm -r exec rimraf dist .next coverage",
    "workspace:list": "pnpm m ls --depth -1",
    "db:generate": "pnpm --filter backend prisma:generate",
    "db:migrate": "pnpm --filter backend prisma:migrate",
    "db:seed": "pnpm --filter backend prisma:seed",
    "ci:check": "pnpm db:generate && pnpm typecheck && pnpm --filter backend build && pnpm --filter frontend build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}
