{
  "name": "service-ops-crm",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "echo \"Use pnpm bootstrap:local + pnpm --filter backend start:dev + pnpm --filter frontend dev, or pnpm bootstrap:docker\"",
    "build": "pnpm -r build",
    "lint": "pnpm --filter backend lint && pnpm --filter frontend lint && pnpm --filter @service-ops/shared-types lint",
    "typecheck": "pnpm -r typecheck",
    "format": "pnpm -r format",
    "clean": "pnpm -r exec rimraf dist .next coverage",
    "workspace:list": "pnpm m ls --depth -1",
    "infra:up": "docker compose --env-file .env.infra.local -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose --env-file .env.infra.local -f docker-compose.dev.yml down",
    "infra:logs": "docker compose --env-file .env.infra.local -f docker-compose.dev.yml logs -f postgres redis minio minio-init",
    "infra:ps": "docker compose --env-file .env.infra.local -f docker-compose.dev.yml ps",
    "infra:reset": "docker compose --env-file .env.infra.local -f docker-compose.dev.yml down -v --remove-orphans",
    "bootstrap:local": "node ./scripts/bootstrap-local.mjs",
    "bootstrap:docker": "node ./scripts/bootstrap-docker.mjs",
    "dev:docker:up": "docker compose --env-file .env.infra.local -f docker-compose.dev.yml --profile app up -d --build",
    "dev:docker:down": "docker compose --env-file .env.infra.local -f docker-compose.dev.yml --profile app down",
    "dev:docker:ps": "docker compose --env-file .env.infra.local -f docker-compose.dev.yml --profile app ps",
    "dev:docker:logs": "docker compose --env-file .env.infra.local -f docker-compose.dev.yml --profile app logs -f backend frontend postgres redis minio minio-init",
    "dev:docker:reset": "docker compose --env-file .env.infra.local -f docker-compose.dev.yml --profile app down -v --remove-orphans",
    "backend:first-admin": "pnpm --filter backend bootstrap:first-admin",
    "test:backend:integration": "pnpm --filter backend test:integration",
    "db:generate": "pnpm --filter backend prisma:generate",
    "db:migrate": "pnpm --filter backend prisma:migrate",
    "db:seed": "pnpm --filter backend prisma:seed",
    "ci:check": "pnpm db:generate && pnpm lint && pnpm typecheck && pnpm --filter backend build && pnpm --filter frontend build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "globals": "^17.5.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.58.2"
  }
}
