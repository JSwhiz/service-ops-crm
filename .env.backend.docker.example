# ============================================================
# Backend Docker-local environment example
# ============================================================

NODE_ENV=development
APP_ENV=local-docker
APP_NAME=Service Ops CRM
BACKEND_PORT=4000
APP_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://service_ops:service_ops_password@postgres:5432/service_ops?schema=public

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# MinIO / S3
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET=service-ops-files
MINIO_PUBLIC_BASE_URL=http://localhost:9000

# Bootstrap
FIRST_ADMIN_LOGIN=founder
FIRST_ADMIN_PASSWORD=founder123
FIRST_ADMIN_FULL_NAME=System Founder
