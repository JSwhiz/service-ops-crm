# Public deployment
APP_DOMAIN=socrm-ru-ru.ru
ACME_EMAIL=admin@socrm-ru-ru.ru
APP_NAME=Service Ops CRM

# Pinned images
POSTGRES_IMAGE=postgres:16.13
REDIS_IMAGE=redis:7.4.8
MINIO_IMAGE=minio/minio:RELEASE.2025-06-13T11-33-47Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
CADDY_IMAGE=caddy:2.10.2-alpine

# PostgreSQL
POSTGRES_DB=service_ops
POSTGRES_USER=service_ops
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://service_ops:CHANGE_ME_RANDOM_DATABASE_PASSWORD@postgres:5432/service_ops?schema=public

# Application
NODE_ENV=production
APP_TIMEZONE=Europe/Moscow
APP_ENV=production
BACKEND_PORT=4000
APP_BASE_URL=https://socrm-ru-ru.ru

# Redis
REDIS_URL=redis://redis:6379

# Authentication
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
AUTH_COOKIE_DOMAIN=socrm-ru-ru.ru
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

# Private object storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=service_ops_storage
MINIO_SECRET_KEY=CHANGE_ME_RANDOM_STORAGE_PASSWORD
MINIO_ROOT_USER=service_ops_storage
MINIO_ROOT_PASSWORD=CHANGE_ME_RANDOM_STORAGE_PASSWORD
MINIO_BUCKET=service-ops-files
MINIO_PUBLIC_BASE_URL=http://minio:9000

# Document previews
FILE_PREVIEW_OFFICE_EXECUTABLE=libreoffice
FILE_PREVIEW_TEMP_DIR=/tmp
FILE_PREVIEW_CONVERSION_TIMEOUT_MS=45000
FILE_PREVIEW_STALE_THRESHOLD_MS=180000
FILE_PREVIEW_MAX_ATTEMPTS=3

# Initial administrator. Replace before the first seed.
FIRST_ADMIN_LOGIN=admin
FIRST_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
FIRST_ADMIN_FULL_NAME=Администратор
