# ============================================================
# Service Ops CRM - root environment example
# ============================================================
# This file documents the global configuration shape of the project.
# Real secrets must never be committed to the repository.
# Use local/private env files for actual runtime values.
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NODE_ENV=development
APP_NAME=Service Ops CRM
APP_ENV=local
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# Frontend public variables
# These values are safe to expose to the browser bundle.
# ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Service Ops CRM
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------
BACKEND_PORT=4000

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=postgresql://service_ops:service_ops_password@localhost:5432/service_ops?schema=public

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------
# MinIO / S3-compatible storage
# ------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET=service-ops-files
MINIO_CONSOLE_URL=http://localhost:9001
