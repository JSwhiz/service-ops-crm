{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node ../../scripts/run-with-env.mjs APP_ENV_FILE ../../.env.backend.local -- node dist/main.js",
    "start:dev": "node ../../scripts/run-with-env.mjs APP_ENV_FILE ../../.env.backend.local -- nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "test:integration": "node ../../scripts/run-with-env.mjs APP_ENV_FILE ../../.env.backend.local -- node scripts/run-integration-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "echo \"Formatting handled at repo level\"",
    "prisma:generate": "node ../../scripts/run-with-env.mjs APP_ENV_FILE ../../.env.backend.local -- prisma generate",
    "prisma:migrate": "node ../../scripts/run-with-env.mjs APP_ENV_FILE ../../.env.backend.local -- prisma migrate dev",
    "prisma:deploy": "node ../../scripts/run-with-env.mjs APP_ENV_FILE ../../.env.backend.local -- prisma migrate deploy",
    "prisma:seed": "node ../../scripts/run-with-env.mjs APP_ENV_FILE ../../.env.backend.local -- tsx prisma/seed.ts",
    "bootstrap:first-admin": "node ../../scripts/run-with-env.mjs APP_ENV_FILE ../../.env.backend.local -- tsx scripts/bootstrap-first-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1031.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^5.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@service-ops/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.6.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
