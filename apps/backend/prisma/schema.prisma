generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String   @id @default(uuid())
  login                       String   @unique
  passwordHash                String?
  fullName                    String
  isActive                    Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  deletedAt                   DateTime?

  roles                       UserRole[]
  permissions                 UserPermission[]
  visibilityGroups            UserVisibilityGroup[]
  approvalCapabilities        UserApprovalCapability[]
  createdApprovalRequests     ApprovalRequest[] @relation("ApprovalRequestCreatedBy")
  resolvedApprovalRequests    ApprovalRequest[] @relation("ApprovalRequestResolvedBy")
  cancelledApprovalRequests   ApprovalRequest[] @relation("ApprovalRequestCancelledBy")
  createdChatRooms            ChatRoom[] @relation("ChatRoomCreatedBy")
  deletedChatRooms            ChatRoom[] @relation("ChatRoomDeletedBy")
  chatRoomParticipants        ChatRoomParticipant[]
  authoredChatMessages        ChatMessage[] @relation("ChatMessageAuthor")
  deletedChatMessages         ChatMessage[] @relation("ChatMessageDeletedBy")
  chatMessageReactions        ChatMessageReaction[]
  editedChatMessageHistory    ChatMessageEditHistory[] @relation("ChatMessageEditHistoryEditedBy")
  auditEvents                 AuditEvent[] @relation("AuditActor")
  createdObjects              Object[] @relation("ObjectCreatedBy")
  createdOneTimeOrders        OneTimeOrder[] @relation("OneTimeOrderCreatedBy")
  reviewedOneTimeOrders       OneTimeOrder[] @relation("OneTimeOrderReviewUpdatedBy")
  completedOneTimeOrders      OneTimeOrder[] @relation("OneTimeOrderCompletedBy")
  oneTimeOrderCompletions     OneTimeOrderCompletion[] @relation("OneTimeOrderCompletionCompletedBy")
  receivedOneTimeOrderCompletionPayments OneTimeOrderCompletionPayment[] @relation("OneTimeOrderCompletionPaymentRecipient")
  recordedOneTimeOrderCompletionPayments OneTimeOrderCompletionPayment[] @relation("OneTimeOrderCompletionPaymentRecordedBy")
  createdOneTimeOrderSpecificationItems OneTimeOrderSpecificationItem[] @relation("OneTimeOrderSpecificationCreatedBy")
  completedOneTimeOrderSpecificationItems OneTimeOrderSpecificationItem[] @relation("OneTimeOrderSpecificationCompletedBy")
  deletedOneTimeOrderSpecificationItems OneTimeOrderSpecificationItem[] @relation("OneTimeOrderSpecificationDeletedBy")
  createdInventoryItems       InventoryItem[] @relation("InventoryItemCreatedBy")
  createdInventoryMovements   InventoryMovement[] @relation("InventoryMovementCreatedBy")
  resolvedInventoryMovementApprovals InventoryMovement[] @relation("InventoryMovementApprovalResolvedBy")
  createdEquipmentCatalogItems EquipmentCatalogItem[] @relation("EquipmentCatalogItemCreatedBy")
  createdEquipmentUnits        EquipmentUnit[] @relation("EquipmentUnitCreatedBy")
  createdEquipmentMovements    EquipmentMovement[] @relation("EquipmentMovementCreatedBy")
  accountabilityAccount        AccountabilityAccount? @relation("UserAccountabilityAccount")
  issuedAccountabilityFundings AccountabilityFunding[] @relation("AccountabilityFundingIssuedBy")
  recordedAccountabilityFundings AccountabilityFunding[] @relation("AccountabilityFundingRecordedBy")
  createdAccountabilityExpenses AccountabilityExpense[] @relation("AccountabilityExpenseCreatedBy")
  approvedAccountabilityExpenses AccountabilityExpense[] @relation("AccountabilityExpenseApprovedBy")
  rejectedAccountabilityExpenses AccountabilityExpense[] @relation("AccountabilityExpenseRejectedBy")
  requestedAccountabilityClosures AccountabilityClosure[] @relation("AccountabilityClosureRequestedBy")
  approvedAccountabilityClosures AccountabilityClosure[] @relation("AccountabilityClosureApprovedBy")
  rejectedAccountabilityClosures AccountabilityClosure[] @relation("AccountabilityClosureRejectedBy")
  objectAssignments           ObjectAssignment[]
  oneTimeOrderAssignments     OneTimeOrderAssignment[]
  createdComments             ObjectComment[] @relation("ObjectCommentCreatedBy")
  createdOneTimeOrderComments OneTimeOrderComment[] @relation("OneTimeOrderCommentCreatedBy")
  createdArrivalPhotos        ObjectArrivalPhoto[] @relation("ObjectArrivalPhotoCreatedBy")
  updatedDailyReports         ObjectDailyReport[] @relation("ObjectDailyReportUpdatedBy")
  updatedOneTimeOrderDailyReports OneTimeOrderDailyReport[] @relation("OneTimeOrderDailyReportUpdatedBy")
  createdOneTimeOrderPhotos   OneTimeOrderPhoto[] @relation("OneTimeOrderPhotoCreatedBy")
  deletedOneTimeOrderPhotos   OneTimeOrderPhoto[] @relation("OneTimeOrderPhotoDeletedBy")
  restoredOneTimeOrderPhotos  OneTimeOrderPhoto[] @relation("OneTimeOrderPhotoRestoredBy")
  oneTimeManagerAvailabilityEntries OneTimeManagerAvailability[] @relation("OneTimeManagerAvailabilityUser")
  requestedOneTimeManagerAvailabilityEntries OneTimeManagerAvailability[] @relation("OneTimeManagerAvailabilityRequestedBy")
  resolvedOneTimeManagerAvailabilityEntries OneTimeManagerAvailability[] @relation("OneTimeManagerAvailabilityResolvedBy")
  cancelledOneTimeManagerAvailabilityEntries OneTimeManagerAvailability[] @relation("OneTimeManagerAvailabilityCancelledBy")
  createdTasks                Task[] @relation("TaskCreatedBy")
  taskAssignments             TaskAssignee[]
  submittedTaskResults        Task[] @relation("TaskSubmittedBy")
  completedTasks              Task[] @relation("TaskCompletedBy")
  cancelledTasks              Task[] @relation("TaskCancelledBy")
  removedTaskAssignments      TaskAssignee[] @relation("TaskAssigneeRemovedBy")
  cancelledTaskCompletions    TaskAssigneeCompletion[] @relation("TaskAssigneeCompletionCancelledBy")
  taskVisibilityMemberships   TaskVisibilityUser[] @relation("TaskVisibilityUser")
  addedTaskVisibilityUsers    TaskVisibilityUser[] @relation("TaskVisibilityAddedBy")
  taskHistoryEvents           TaskHistoryEvent[] @relation("TaskHistoryActor")
  createdAttendanceFacts      ObjectAttendanceFact[] @relation("ObjectAttendanceFactCreatedBy")
  createdTimesheetMonths      TimesheetMonth[] @relation("TimesheetMonthCreatedBy")
  createdTimesheetEntries     TimesheetDayEntry[] @relation("TimesheetEntryCreatedBy")
  updatedTimesheetEntries     TimesheetDayEntry[] @relation("TimesheetEntryUpdatedBy")
  requestedTimesheetManualExceptions TimesheetManualException[] @relation("TimesheetManualExceptionRequestedBy")
  resolvedTimesheetManualExceptions  TimesheetManualException[] @relation("TimesheetManualExceptionResolvedBy")
  objectAuditLogs             ObjectAuditLog[] @relation("ObjectAuditLogActor")
  authSessions                AuthSession[]
  uploadedFiles               File[]          @relation("FileUploadedBy")
  fileAttachments             FileAttachment[] @relation("FileAttachmentCreatedBy")
  createdEmployeeAvailabilityWindows EmployeeAvailabilityWindow[] @relation("EmployeeAvailabilityCreatedBy")
  createdEmployeeSubstitutions EmployeeSubstitution[] @relation("EmployeeSubstitutionCreatedBy")
  createdEmployeeAssignmentHistory EmployeeObjectAssignmentHistory[] @relation("EmployeeAssignmentHistoryCreatedBy")
  closedEmployeeAssignmentHistory  EmployeeObjectAssignmentHistory[] @relation("EmployeeAssignmentHistoryClosedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserPermission[]
  roles RolePermission[]

  @@map("permissions")
}

model VisibilityGroup {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  scopeType   String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserVisibilityGroup[]

  @@map("visibility_groups")
}

model ApprovalCapability {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserApprovalCapability[]

  @@map("approval_capabilities")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model UserPermission {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserVisibilityGroup {
  id                String   @id @default(uuid())
  userId            String
  visibilityGroupId String
  createdAt         DateTime @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  visibilityGroup VisibilityGroup @relation(fields: [visibilityGroupId], references: [id], onDelete: Cascade)

  @@unique([userId, visibilityGroupId])
  @@index([userId])
  @@index([visibilityGroupId])
  @@map("user_visibility_groups")
}

model UserApprovalCapability {
  id                   String   @id @default(uuid())
  userId               String
  approvalCapabilityId String
  createdAt            DateTime @default(now())

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvalCapability ApprovalCapability @relation(fields: [approvalCapabilityId], references: [id], onDelete: Cascade)

  @@unique([userId, approvalCapabilityId])
  @@index([userId])
  @@index([approvalCapabilityId])
  @@map("user_approval_capabilities")
}

model ApprovalRequest {
  id                String   @id @default(uuid())
  approvalType      String
  sourceEntityType  String
  sourceEntityId    String
  status            String   @default("pending")
  createdByUserId   String
  resolvedByUserId  String?
  cancelledByUserId String?
  decisionComment   String?
  payloadSnapshot   Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  resolvedAt        DateTime?
  cancelledAt       DateTime?

  createdBy   User  @relation("ApprovalRequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  resolvedBy  User? @relation("ApprovalRequestResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  cancelledBy User? @relation("ApprovalRequestCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([approvalType, status])
  @@index([sourceEntityType, sourceEntityId])
  @@index([createdByUserId])
  @@index([resolvedByUserId])
  @@index([cancelledByUserId])
  @@map("approval_requests")
}

model ChatRoom {
  id                 String   @id @default(uuid())
  code               String?  @unique
  title              String
  roomType           String
  visibilityType     String
  directKey          String?  @unique
  createdByUserId    String?
  deletedByUserId    String?
  deletedAt          DateTime?
  deleteReason       String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdBy    User?                 @relation("ChatRoomCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deletedBy    User?                 @relation("ChatRoomDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  participants ChatRoomParticipant[]
  messages     ChatMessage[]

  @@index([roomType])
  @@index([visibilityType])
  @@index([lastMessageAt])
  @@index([createdByUserId])
  @@index([deletedByUserId])
  @@index([deletedAt])
  @@map("chat_rooms")
}

model ChatRoomParticipant {
  id             String   @id @default(uuid())
  chatRoomId     String
  userId         String
  roleInRoom     String   @default("member")
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?
  hiddenAt       DateTime?
  leftAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, userId])
  @@index([chatRoomId])
  @@index([userId])
  @@index([roleInRoom])
  @@index([hiddenAt])
  @@index([leftAt])
  @@map("chat_room_participants")
}

model ChatMessage {
  id            String   @id @default(uuid())
  chatRoomId    String
  authorUserId  String?
  messageType   String
  text          String?
  metadata      Json?
  editedAt      DateTime?
  deletedAt     DateTime?
  deletedByUserId String?
  deletedByKind String?
  deleteReason  String?
  replyToMessageId String?
  forwardedFromMessageId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  author   User?    @relation("ChatMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  deletedBy User?   @relation("ChatMessageDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  replyTo   ChatMessage?  @relation("ChatMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatMessageReplies")
  forwardedFrom ChatMessage?  @relation("ChatMessageForwards", fields: [forwardedFromMessageId], references: [id], onDelete: SetNull)
  forwards      ChatMessage[] @relation("ChatMessageForwards")
  reactions     ChatMessageReaction[]
  editHistory   ChatMessageEditHistory[]

  @@index([chatRoomId, createdAt])
  @@index([authorUserId])
  @@index([deletedByUserId])
  @@index([deletedAt])
  @@index([replyToMessageId])
  @@index([forwardedFromMessageId])
  @@index([messageType])
  @@map("chat_messages")
}

model ChatMessageEditHistory {
  id             String   @id @default(uuid())
  chatMessageId  String
  editedByUserId String
  oldText        String?
  newText        String?
  createdAt      DateTime @default(now())

  chatMessage ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  editedBy    User        @relation("ChatMessageEditHistoryEditedBy", fields: [editedByUserId], references: [id], onDelete: Restrict)

  @@index([chatMessageId])
  @@index([editedByUserId])
  @@index([createdAt])
  @@map("chat_message_edit_history")
}

model ChatMessageReaction {
  id            String   @id @default(uuid())
  chatMessageId String
  userId        String
  reactionType  String
  createdAt     DateTime @default(now())

  chatMessage ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatMessageId, userId, reactionType])
  @@index([chatMessageId])
  @@index([userId])
  @@map("chat_message_reactions")
}

model Object {
  id                  String   @id @default(uuid())
  name                String
  internalName        String?
  address             String
  status              String
  seasonMode          String?
  dailyRate           Int      @default(0)
  notes               String?
  createdByUserId     String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  attendanceFacts      ObjectAttendanceFact[]
  createdBy            User                     @relation("ObjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignments          ObjectAssignment[]
  arrivalPhotos        ObjectArrivalPhoto[]
  dailyReports         ObjectDailyReport[]
  comments             ObjectComment[]
  tasks                Task[]
  employeeAssignments  ObjectEmployeeAssignment[]
  employeeAssignmentHistory EmployeeObjectAssignmentHistory[]
  employeeSubstitutions EmployeeSubstitution[]
  linkedOneTimeOrders   OneTimeOrder[]
  inventoryMovements    InventoryMovement[]
  currentEquipmentUnits   EquipmentUnit[]
  equipmentMovementsFrom  EquipmentMovement[] @relation("EquipmentMovementFromObject")
  equipmentMovementsTo    EquipmentMovement[] @relation("EquipmentMovementToObject")
  timesheetMonths         TimesheetMonth[]
  timesheetManualExceptions TimesheetManualException[]
  auditLogs               ObjectAuditLog[]

  @@index([status])
  @@index([createdByUserId])
  @@map("objects")
}

model ObjectAssignment {
  id                 String   @id @default(uuid())
  objectId           String
  userId             String
  assignmentRoleCode String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  object Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A PostgreSQL partial unique index guarantees one active `responsible`
  /// assignment per object; see migration 20260714100000_object_one_responsible.
  @@index([objectId])
  @@index([userId])
  @@index([assignmentRoleCode])
  @@unique([objectId, userId, assignmentRoleCode])
  @@map("object_assignments")
}

model Employee {
  id                 String   @id @default(uuid())
  fullName           String
  phone              String?
  position           String?
  birthDate          DateTime? @db.Date
  employeeType       String   @default("regular")
  workScheduleCode   String?
  workScheduleCustom String?
  workTimeText       String?
  residenceAddress   String?
  shiftPreferences   String?
  baseDailyRate      Int?
  notes              String?
  employmentStatus   String
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  attendanceFacts    ObjectAttendanceFact[]
  objectAssignments  ObjectEmployeeAssignment[]
  objectAssignmentHistory EmployeeObjectAssignmentHistory[]
  availabilityWindows EmployeeAvailabilityWindow[]
  substitutionsAsPrimary EmployeeSubstitution[] @relation("EmployeeSubstitutionPrimary")
  substitutionsAsReplacement EmployeeSubstitution[] @relation("EmployeeSubstitutionReplacement")
  timesheetRows      TimesheetEmployeeRow[]
  timesheetManualExceptions TimesheetManualException[]

  @@index([fullName])
  @@index([phone])
  @@index([position])
  @@index([employmentStatus])
  @@index([employeeType])
  @@index([birthDate])
  @@index([workScheduleCode])
  @@index([deletedAt])
  @@map("employees")
}

model EmployeeObjectAssignmentHistory {
  id              String   @id @default(uuid())
  employeeId      String
  objectId        String
  startedAt       DateTime
  endedAt         DateTime?
  createdByUserId String
  closedByUserId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  object    Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdBy User     @relation("EmployeeAssignmentHistoryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  closedBy  User?    @relation("EmployeeAssignmentHistoryClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([objectId])
  @@index([endedAt])
  @@map("employee_object_assignment_history")
}

model EmployeeAvailabilityWindow {
  id                 String   @id @default(uuid())
  employeeId         String
  startDate          DateTime
  endDate            DateTime?
  availabilityMode   String   @default("full_day")
  availabilityStatus String
  comment            String?
  createdByUserId    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User     @relation("EmployeeAvailabilityCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([employeeId, startDate])
  @@index([availabilityStatus])
  @@map("employee_availability_windows")
}

model EmployeeSubstitution {
  id                   String   @id @default(uuid())
  employeeId           String
  substituteEmployeeId String
  objectId             String?
  startDate            DateTime
  endDate              DateTime?
  status               String
  reason               String
  comment              String?
  createdByUserId      String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  employee           Employee @relation("EmployeeSubstitutionPrimary", fields: [employeeId], references: [id], onDelete: Restrict)
  substituteEmployee Employee @relation("EmployeeSubstitutionReplacement", fields: [substituteEmployeeId], references: [id], onDelete: Restrict)
  object             Object?   @relation(fields: [objectId], references: [id], onDelete: SetNull)
  createdBy          User      @relation("EmployeeSubstitutionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([employeeId, startDate])
  @@index([substituteEmployeeId, startDate])
  @@index([objectId])
  @@index([status])
  @@map("employee_substitutions")
}

model ObjectAuditLog {
  id          String   @id @default(uuid())
  objectId    String
  actorUserId String
  actionCode  String
  payload     Json?
  createdAt   DateTime @default(now())

  object Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  actor  User   @relation("ObjectAuditLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([objectId])
  @@index([actorUserId])
  @@index([actionCode])
  @@index([createdAt])
  @@map("object_audit_logs")
}

model ObjectEmployeeAssignment {
  id          String   @id @default(uuid())
  objectId    String
  employeeId  String
  isActive    Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
  ratePolicyType String @default("daily_rate")
  ratePolicyBaseAmount Int?
  ratePolicyScheduleCode String?
  ratePolicyRoundingMode String?
  ratePolicyRoundingStep Int?
  ratePolicyStandardShiftHours Float?
  ratePolicyWorkingDaysInMonth Int?
  ratePolicyExcludedHolidayDays Int?
  ratePolicyNotes String?
  ratePolicyUpdatedByUserId String?
  ratePolicyUpdatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  object      Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([objectId, employeeId])
  @@index([objectId])
  @@index([employeeId])
  @@map("object_employee_assignments")
}

model ObjectArrivalPhoto {
  id              String   @id @default(uuid())
  objectId        String
  operationDate   DateTime
  photoUrl        String?
  photoType       String?
  comment         String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  object    Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ObjectArrivalPhotoCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([objectId, operationDate])
  @@index([objectId, operationDate])
  @@map("object_arrival_photos")
}

model ObjectDailyReport {
  id              String   @id @default(uuid())
  objectId        String
  reportDate      DateTime
  content         String
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  object    Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  updatedBy User   @relation("ObjectDailyReportUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@unique([objectId, reportDate])
  @@index([objectId, reportDate])
  @@map("object_daily_reports")
}

model ObjectComment {
  id              String   @id @default(uuid())
  objectId        String
  content         String
  commentType     String   @default("manual")
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  object    Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ObjectCommentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([objectId, createdAt])
  @@map("object_comments")
}

model OneTimeOrder {
  id                String   @id @default(uuid())
  title             String
  executionAddress  String
  linkedObjectId    String?
  status            String
  description       String?
  executionDate     DateTime?
  executionStartDate DateTime? @db.Date
  executionEndDate   DateTime? @db.Date
  contactName       String
  contactPhone      String?
  agreedSum         Int?
  financialNotes    String?
  expenseNotes      String?
  reviewText        String?
  reviewRating      Int?
  reviewUpdatedAt   DateTime?
  reviewUpdatedByUserId String?
  workCycle         Int      @default(1)
  completedAt       DateTime?
  completedByUserId String?
  createdByUserId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  linkedObject      Object?                @relation(fields: [linkedObjectId], references: [id], onDelete: SetNull)
  createdBy         User                   @relation("OneTimeOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewUpdatedBy   User?                  @relation("OneTimeOrderReviewUpdatedBy", fields: [reviewUpdatedByUserId], references: [id], onDelete: SetNull)
  completedBy       User?                  @relation("OneTimeOrderCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  assignments       OneTimeOrderAssignment[]
  comments          OneTimeOrderComment[]
  dailyReports      OneTimeOrderDailyReport[]
  photos            OneTimeOrderPhoto[]
  inventoryMovements InventoryMovement[]
  currentEquipmentUnits EquipmentUnit[]
  equipmentMovementsFrom EquipmentMovement[] @relation("EquipmentMovementFromOneTimeOrder")
  equipmentMovementsTo   EquipmentMovement[] @relation("EquipmentMovementToOneTimeOrder")
  tasks             Task[]
  specificationItems OneTimeOrderSpecificationItem[]
  completions       OneTimeOrderCompletion[]
  completionPayments OneTimeOrderCompletionPayment[]
  accountabilityFundings AccountabilityFunding[]
  accountabilityExpenses AccountabilityExpense[]

  @@index([linkedObjectId])
  @@index([status])
  @@index([createdByUserId])
  @@index([reviewUpdatedByUserId])
  @@index([completedByUserId])
  @@index([executionStartDate])
  @@index([executionEndDate])
  @@map("one_time_orders")
}

model OneTimeOrderCompletion {
  id                 String   @id @default(uuid())
  oneTimeOrderId     String
  workCycle          Int
  completedAt        DateTime?
  completedByUserId  String?
  completionComment  String?
  completionSource   String   @default("native")
  status             String
  clientRequestId    String?
  payloadFingerprint String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  oneTimeOrder OneTimeOrder @relation(fields: [oneTimeOrderId], references: [id], onDelete: Restrict)
