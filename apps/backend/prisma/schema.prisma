generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String   @id @default(uuid())
  login                       String   @unique
  passwordHash                String?
  fullName                    String
  isActive                    Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  deletedAt                   DateTime?

  roles                       UserRole[]
  permissions                 UserPermission[]
  visibilityGroups            UserVisibilityGroup[]
  approvalCapabilities        UserApprovalCapability[]
  auditEvents                 AuditEvent[] @relation("AuditActor")
  createdObjects              Object[] @relation("ObjectCreatedBy")
  createdOneTimeOrders        OneTimeOrder[] @relation("OneTimeOrderCreatedBy")
  createdInventoryItems       InventoryItem[] @relation("InventoryItemCreatedBy")
  createdInventoryMovements   InventoryMovement[] @relation("InventoryMovementCreatedBy")
  objectAssignments           ObjectAssignment[]
  oneTimeOrderAssignments     OneTimeOrderAssignment[]
  createdComments             ObjectComment[] @relation("ObjectCommentCreatedBy")
  createdOneTimeOrderComments OneTimeOrderComment[] @relation("OneTimeOrderCommentCreatedBy")
  createdArrivalPhotos        ObjectArrivalPhoto[] @relation("ObjectArrivalPhotoCreatedBy")
  updatedDailyReports         ObjectDailyReport[] @relation("ObjectDailyReportUpdatedBy")
  updatedOneTimeOrderDailyReports OneTimeOrderDailyReport[] @relation("OneTimeOrderDailyReportUpdatedBy")
  createdOneTimeOrderPhotos   OneTimeOrderPhoto[] @relation("OneTimeOrderPhotoCreatedBy")
  createdTasks                Task[] @relation("TaskCreatedBy")
  taskAssignments             TaskAssignee[]
  submittedTaskResults        Task[] @relation("TaskSubmittedBy")
  createdAttendanceFacts      ObjectAttendanceFact[] @relation("ObjectAttendanceFactCreatedBy")
  createdTimesheetMonths      TimesheetMonth[] @relation("TimesheetMonthCreatedBy")
  createdTimesheetEntries     TimesheetDayEntry[] @relation("TimesheetEntryCreatedBy")
  updatedTimesheetEntries     TimesheetDayEntry[] @relation("TimesheetEntryUpdatedBy")
  objectAuditLogs             ObjectAuditLog[] @relation("ObjectAuditLogActor")
  authSessions                AuthSession[]
  uploadedFiles               File[]          @relation("FileUploadedBy")
  fileAttachments             FileAttachment[] @relation("FileAttachmentCreatedBy")
  createdEmployeeAvailabilityWindows EmployeeAvailabilityWindow[] @relation("EmployeeAvailabilityCreatedBy")
  createdEmployeeSubstitutions EmployeeSubstitution[] @relation("EmployeeSubstitutionCreatedBy")
  createdEmployeeAssignmentHistory EmployeeObjectAssignmentHistory[] @relation("EmployeeAssignmentHistoryCreatedBy")
  closedEmployeeAssignmentHistory  EmployeeObjectAssignmentHistory[] @relation("EmployeeAssignmentHistoryClosedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserPermission[]

  @@map("permissions")
}

model VisibilityGroup {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  scopeType   String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserVisibilityGroup[]

  @@map("visibility_groups")
}

model ApprovalCapability {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserApprovalCapability[]

  @@map("approval_capabilities")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model UserPermission {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

model UserVisibilityGroup {
  id                String   @id @default(uuid())
  userId            String
  visibilityGroupId String
  createdAt         DateTime @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  visibilityGroup VisibilityGroup @relation(fields: [visibilityGroupId], references: [id], onDelete: Cascade)

  @@unique([userId, visibilityGroupId])
  @@index([userId])
  @@index([visibilityGroupId])
  @@map("user_visibility_groups")
}

model UserApprovalCapability {
  id                   String   @id @default(uuid())
  userId               String
  approvalCapabilityId String
  createdAt            DateTime @default(now())

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvalCapability ApprovalCapability @relation(fields: [approvalCapabilityId], references: [id], onDelete: Cascade)

  @@unique([userId, approvalCapabilityId])
  @@index([userId])
  @@index([approvalCapabilityId])
  @@map("user_approval_capabilities")
}

model Object {
  id                  String   @id @default(uuid())
  name                String
  internalName        String?
  address             String
  status              String
  seasonMode          String   @default("summer")
  dailyRate           Int      @default(0)
  notes               String?
  createdByUserId     String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  attendanceFacts      ObjectAttendanceFact[]
  createdBy            User                     @relation("ObjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignments          ObjectAssignment[]
  arrivalPhotos        ObjectArrivalPhoto[]
  dailyReports         ObjectDailyReport[]
  comments             ObjectComment[]
  tasks                Task[]
  employeeAssignments  ObjectEmployeeAssignment[]
  employeeAssignmentHistory EmployeeObjectAssignmentHistory[]
  employeeSubstitutions EmployeeSubstitution[]
  linkedOneTimeOrders   OneTimeOrder[]
  inventoryMovements    InventoryMovement[]
  timesheetMonths      TimesheetMonth[]
  auditLogs            ObjectAuditLog[]

  @@index([status])
  @@index([createdByUserId])
  @@map("objects")
}

model ObjectAssignment {
  id                 String   @id @default(uuid())
  objectId           String
  userId             String
  assignmentRoleCode String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  object Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([objectId])
  @@index([userId])
  @@index([assignmentRoleCode])
  @@unique([objectId, userId, assignmentRoleCode])
  @@map("object_assignments")
}

model Employee {
  id                 String   @id @default(uuid())
  fullName           String
  phone              String?
  residenceAddress   String?
  shiftPreferences   String?
  baseDailyRate      Int?
  notes              String?
  employmentStatus   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  attendanceFacts    ObjectAttendanceFact[]
  objectAssignments  ObjectEmployeeAssignment[]
  objectAssignmentHistory EmployeeObjectAssignmentHistory[]
  availabilityWindows EmployeeAvailabilityWindow[]
  substitutionsAsPrimary EmployeeSubstitution[] @relation("EmployeeSubstitutionPrimary")
  substitutionsAsReplacement EmployeeSubstitution[] @relation("EmployeeSubstitutionReplacement")
  timesheetRows      TimesheetEmployeeRow[]

  @@index([employmentStatus])
  @@map("employees")
}

model EmployeeObjectAssignmentHistory {
  id              String   @id @default(uuid())
  employeeId      String
  objectId        String
  startedAt       DateTime
  endedAt         DateTime?
  createdByUserId String
  closedByUserId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  object    Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdBy User     @relation("EmployeeAssignmentHistoryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  closedBy  User?    @relation("EmployeeAssignmentHistoryClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([objectId])
  @@index([endedAt])
  @@map("employee_object_assignment_history")
}

model EmployeeAvailabilityWindow {
  id                 String   @id @default(uuid())
  employeeId         String
  startDate          DateTime
  endDate            DateTime?
  availabilityMode   String   @default("full_day")
  availabilityStatus String
  comment            String?
  createdByUserId    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy User     @relation("EmployeeAvailabilityCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([employeeId, startDate])
  @@index([availabilityStatus])
  @@map("employee_availability_windows")
}

model EmployeeSubstitution {
  id                   String   @id @default(uuid())
  employeeId           String
  substituteEmployeeId String
  objectId             String?
  startDate            DateTime
  endDate              DateTime?
  status               String
  reason               String
  comment              String?
  createdByUserId      String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  employee           Employee @relation("EmployeeSubstitutionPrimary", fields: [employeeId], references: [id], onDelete: Cascade)
  substituteEmployee Employee @relation("EmployeeSubstitutionReplacement", fields: [substituteEmployeeId], references: [id], onDelete: Cascade)
  object             Object?   @relation(fields: [objectId], references: [id], onDelete: SetNull)
  createdBy          User      @relation("EmployeeSubstitutionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([employeeId, startDate])
  @@index([substituteEmployeeId, startDate])
  @@index([objectId])
  @@index([status])
  @@map("employee_substitutions")
}

model ObjectAuditLog {
  id          String   @id @default(uuid())
  objectId    String
  actorUserId String
  actionCode  String
  payload     Json?
  createdAt   DateTime @default(now())

  object Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  actor  User   @relation("ObjectAuditLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([objectId])
  @@index([actorUserId])
  @@index([actionCode])
  @@index([createdAt])
  @@map("object_audit_logs")
}

model ObjectEmployeeAssignment {
  id          String   @id @default(uuid())
  objectId    String
  employeeId  String
  isActive    Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  object      Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([objectId, employeeId])
  @@index([objectId])
  @@index([employeeId])
  @@map("object_employee_assignments")
}

model ObjectArrivalPhoto {
  id              String   @id @default(uuid())
  objectId        String
  operationDate   DateTime
  photoUrl        String?
  photoType       String?
  comment         String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  object    Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ObjectArrivalPhotoCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([objectId, operationDate])
  @@index([objectId, operationDate])
  @@map("object_arrival_photos")
}

model ObjectDailyReport {
  id              String   @id @default(uuid())
  objectId        String
  reportDate      DateTime
  content         String
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  object    Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  updatedBy User   @relation("ObjectDailyReportUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@unique([objectId, reportDate])
  @@index([objectId, reportDate])
  @@map("object_daily_reports")
}

model ObjectComment {
  id              String   @id @default(uuid())
  objectId        String
  content         String
  commentType     String   @default("manual")
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  object    Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ObjectCommentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([objectId, createdAt])
  @@map("object_comments")
}

model OneTimeOrder {
  id                String   @id @default(uuid())
  title             String
  executionAddress  String
  linkedObjectId    String?
  status            String
  description       String?
  executionDate     DateTime?
  contactName       String
  contactPhone      String?
  agreedSum         Int?
  financialNotes    String?
  expenseNotes      String?
  createdByUserId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  linkedObject      Object?                @relation(fields: [linkedObjectId], references: [id], onDelete: SetNull)
  createdBy         User                   @relation("OneTimeOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignments       OneTimeOrderAssignment[]
  comments          OneTimeOrderComment[]
  dailyReports      OneTimeOrderDailyReport[]
  photos            OneTimeOrderPhoto[]
  inventoryMovements InventoryMovement[]
  tasks             Task[]

  @@index([linkedObjectId])
  @@index([status])
  @@index([createdByUserId])
  @@map("one_time_orders")
}

model OneTimeOrderAssignment {
  id                 String   @id @default(uuid())
  oneTimeOrderId     String
  userId             String
  assignmentRoleCode String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  oneTimeOrder OneTimeOrder @relation(fields: [oneTimeOrderId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([oneTimeOrderId])
  @@index([userId])
  @@index([assignmentRoleCode])
  @@unique([oneTimeOrderId, userId, assignmentRoleCode])
  @@map("one_time_order_assignments")
}

model OneTimeOrderComment {
  id                String   @id @default(uuid())
  oneTimeOrderId    String
  content           String
  commentType       String   @default("manual")
  createdByUserId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  oneTimeOrder OneTimeOrder @relation(fields: [oneTimeOrderId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("OneTimeOrderCommentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([oneTimeOrderId, createdAt])
  @@map("one_time_order_comments")
}

model OneTimeOrderDailyReport {
  id                String   @id @default(uuid())
  oneTimeOrderId    String
  reportDate        DateTime
  content           String
  updatedByUserId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  oneTimeOrder OneTimeOrder @relation(fields: [oneTimeOrderId], references: [id], onDelete: Cascade)
  updatedBy    User         @relation("OneTimeOrderDailyReportUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@unique([oneTimeOrderId, reportDate])
  @@index([oneTimeOrderId, reportDate])
  @@map("one_time_order_daily_reports")
}

model OneTimeOrderPhoto {
  id                String   @id @default(uuid())
  oneTimeOrderId    String
  photoCategory     String
  comment           String?
  createdByUserId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  oneTimeOrder OneTimeOrder @relation(fields: [oneTimeOrderId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("OneTimeOrderPhotoCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([oneTimeOrderId, createdAt])
  @@index([photoCategory])
  @@map("one_time_order_photos")
}

model Task {
  id                String   @id @default(uuid())
  title             String
  description       String?
  priority          String
  status            String
  objectId          String?
  oneTimeOrderId    String?
  createdByUserId   String
  resultText        String?
  submittedByUserId String?
  submittedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  object      Object?        @relation(fields: [objectId], references: [id], onDelete: Cascade)
  oneTimeOrder OneTimeOrder? @relation(fields: [oneTimeOrderId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  submittedBy User?          @relation("TaskSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  assignees   TaskAssignee[]

  @@index([objectId])
  @@index([oneTimeOrderId])
  @@index([status])
  @@index([createdByUserId])
  @@map("tasks")
}

model TaskAssignee {
  id          String   @id @default(uuid())
  taskId      String
  userId      String
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_assignees")
}

model InventoryItem {
  id              String   @id @default(uuid())
  name            String
  category        String
  unit            String
  isActive        Boolean  @default(true)
  notes           String?
  currentUnitPrice Decimal? @db.Decimal(12, 2)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy       User                @relation("InventoryItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  movements       InventoryMovement[]

  @@index([createdByUserId])
  @@index([category])
  @@index([isActive])
  @@map("inventory_items")
}

model InventoryMovement {
  id                   String   @id @default(uuid())
  inventoryItemId      String
  movementType         String
  quantity             Decimal  @db.Decimal(12, 3)
  unitPriceSnapshot    Decimal  @db.Decimal(12, 2)
  totalAmountSnapshot  Decimal  @db.Decimal(14, 2)
  adjustmentDirection  String?
  comment              String?
  evidenceRequired     Boolean  @default(false)
  requiresApprovalBridge Boolean @default(false)
  approvalBridgeType   String?
  createdByUserId      String
  relatedObjectId      String?
  relatedOneTimeOrderId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  inventoryItem        InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  createdBy            User          @relation("InventoryMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  relatedObject        Object?       @relation(fields: [relatedObjectId], references: [id], onDelete: SetNull)
  relatedOneTimeOrder  OneTimeOrder? @relation(fields: [relatedOneTimeOrderId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
  @@index([movementType])
  @@index([createdByUserId])
  @@index([relatedObjectId])
  @@index([relatedOneTimeOrderId])
  @@index([createdAt])
  @@map("inventory_movements")
}

model TimesheetMonth {
  id              String   @id @default(uuid())
  objectId        String
  year            Int
  month           Int
  status          String   @default("open")
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  object          Object               @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdBy       User?                @relation("TimesheetMonthCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  rows            TimesheetEmployeeRow[]

  @@unique([objectId, year, month])
  @@index([objectId])
  @@index([year, month])
  @@map("timesheet_months")
}

model TimesheetEmployeeRow {
  id                   String   @id @default(uuid())
  timesheetMonthId     String
  employeeId           String
  employeeNameSnapshot String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  timesheetMonth       TimesheetMonth     @relation(fields: [timesheetMonthId], references: [id], onDelete: Cascade)
  employee             Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  entries              TimesheetDayEntry[]

  @@unique([timesheetMonthId, employeeId])
  @@index([timesheetMonthId])
  @@index([employeeId])
  @@map("timesheet_employee_rows")
}

model TimesheetDayEntry {
  id                 String   @id @default(uuid())
  rowId              String
  dayOfMonth         Int
  dayValue           Int      @default(0)
  comment            String?
  isChangedManually  Boolean  @default(false)
  createdByUserId    String?
  updatedByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  row                TimesheetEmployeeRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  createdBy          User?                @relation("TimesheetEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy          User?                @relation("TimesheetEntryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([rowId, dayOfMonth])
  @@index([rowId])
  @@index([dayOfMonth])
  @@map("timesheet_day_entries")
}

model File {
  id               String   @id @default(uuid())
  bucket           String
  objectKey        String   @unique
  originalName     String
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String?
  createdAt        DateTime @default(now())
  deletedAt        DateTime?

  uploadedBy       User?             @relation("FileUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  attachments      FileAttachment[]

  @@index([uploadedByUserId])
  @@map("files")
}

model FileAttachment {
  id               String   @id @default(uuid())
  fileId           String
  entityType       String
  entityId         String
  fieldCode        String?
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  file             File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy       User?  @relation("FileAttachmentCreatedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([fileId])
  @@index([entityType, entityId])
  @@index([uploadedByUserId])
  @@map("file_attachments")
}

model AuditEvent {
  id          String   @id @default(uuid())
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  oldValues   Json?
  newValues   Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

model ObjectAttendanceFact {
  id              String   @id @default(uuid())
  objectId        String
  employeeId      String
  operationDate   DateTime
  dailyRateSnapshot Int
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  object          Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("ObjectAttendanceFactCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([objectId, employeeId, operationDate])
  @@index([objectId, operationDate])
  @@index([employeeId, operationDate])
  @@map("object_attendance_facts")
}

model AuthSession {
  id                  String       @id @default(uuid())
  userId              String
  tokenHash           String       @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBySession   AuthSession? @relation("AuthSessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  rotatedSessions     AuthSession[] @relation("AuthSessionRotation")

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("auth_sessions")
}
