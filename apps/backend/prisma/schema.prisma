  month                   Int
  dayOfMonth              Int
  requestedDayValue       Int
  currentDayValueSnapshot Int
  comment                 String
  status                  String   @default("pending")
  requestedByUserId       String
  resolvedByUserId        String?
  resolvedAt              DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  object      Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  requestedBy User     @relation("TimesheetManualExceptionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  resolvedBy  User?    @relation("TimesheetManualExceptionResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([objectId, year, month])
  @@index([employeeId, year, month])
  @@index([status])
  @@index([requestedByUserId])
  @@index([resolvedByUserId])
  @@map("timesheet_manual_exceptions")
}

model File {
  id               String   @id @default(uuid())
  bucket           String
  objectKey        String   @unique
  originalName     String
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String?
  createdAt        DateTime @default(now())
  deletedAt        DateTime?

  uploadedBy       User?             @relation("FileUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  attachments      FileAttachment[]
  derivatives      FileDerivative[]

  @@index([uploadedByUserId])
  @@map("files")
}

model FileDerivative {
  id                  String    @id @default(uuid())
  fileId              String
  derivativeType      String
  status              String
  objectKey           String?
  mimeType            String?
  sizeBytes           Int?
  width               Int?
  height              Int?
  errorMessage        String?
  processingStartedAt DateTime?
  attemptCount        Int       @default(0)
  lastAttemptAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, derivativeType])
  @@index([fileId])
  @@index([status])
  @@index([status, processingStartedAt])
  @@map("file_derivatives")
}

model FileAttachment {
  id               String   @id @default(uuid())
  fileId           String
  entityType       String
  entityId         String
  fieldCode        String?
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  file             File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy       User?  @relation("FileAttachmentCreatedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([fileId])
  @@index([entityType, entityId])
  @@index([uploadedByUserId])
  @@map("file_attachments")
}

model AuditEvent {
  id          String   @id @default(uuid())
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  oldValues   Json?
  newValues   Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

model ObjectAttendanceFact {
  id              String   @id @default(uuid())
  objectId        String
  employeeId      String
  operationDate   DateTime
  dailyRateSnapshot Int
  workedHours     Float?
  ratePolicySnapshot Json?
  calculationExplanation String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  object          Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy       User?    @relation("ObjectAttendanceFactCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([objectId, employeeId, operationDate])
  @@index([objectId, operationDate])
  @@index([employeeId, operationDate])
  @@map("object_attendance_facts")
}

model AuthSession {
  id                  String       @id @default(uuid())
  userId              String
  tokenHash           String       @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBySession   AuthSession? @relation("AuthSessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  rotatedSessions     AuthSession[] @relation("AuthSessionRotation")

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("auth_sessions")
}
