{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run-with-env.mjs FRONTEND_ENV_FILE ../../.env.frontend.local -- next dev --hostname 0.0.0.0 --port 3000",
    "build": "node ../../scripts/run-with-env.mjs FRONTEND_ENV_FILE ../../.env.frontend.local -- next build",
    "start": "node ../../scripts/run-with-env.mjs FRONTEND_ENV_FILE ../../.env.frontend.local -- next start -H 0.0.0.0 -p 3000",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "echo \"Formatting handled at repo level\"",
    "clean": "rimraf .next"
  },
  "dependencies": {
    "@service-ops/shared-types": "workspace:*",
    "next": "^15.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@service-ops/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2"
  }
}
