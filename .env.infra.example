# ============================================================
# Infrastructure environment example
# ============================================================

# PostgreSQL
POSTGRES_IMAGE=postgres:16.13
POSTGRES_DB=service_ops
POSTGRES_USER=service_ops
POSTGRES_PASSWORD=service_ops_password
POSTGRES_HOST_PORT=55432

# Redis
REDIS_IMAGE=redis:7.4.8
REDIS_HOST_PORT=6379

# MinIO
MINIO_IMAGE=minio/minio:RELEASE.2025-06-13T11-33-47Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_BUCKET=service-ops-files

# Dockerized app ports / base image
DEV_NODE_IMAGE=node:22.22-bookworm
BACKEND_HOST_PORT=4000
FRONTEND_HOST_PORT=3000
